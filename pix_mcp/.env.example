# URL do pix-service (repositório separado). Sem default no código: o README diz 8080 e o
# application.yml usa 8089 (D-10 em docs/pagamentos-pix.md). O compose já injeta um valor de dev.
PIX_SERVICE_URL=http://host.docker.internal:8089
RECURSOS_MCP_URL=http://recursos:8000/mcp_gateway
PIX_HTTP_TIMEOUT=5

# Vínculo CPF -> carteira (contém CPF em texto claro: não versionar)
PIX_DB_FILE=/app/pix_db.json
# Segredo do HMAC do userId enviado ao pix-service. Troque fora de desenvolvimento.
PIX_USER_ID_SECRET=
PIX_MAX_CHAVES=5
# Valida os dígitos verificadores do CPF ao cadastrar chave CPF (o pix-service não valida)
PIX_VALIDAR_DV_CPF=true

# Logs de correlação: LOG_PAYLOAD=off|truncated|full
LOG_PAYLOAD=truncated
LOG_PAYLOAD_MAX_CHARS=2000
LOG_LEVEL=INFO
