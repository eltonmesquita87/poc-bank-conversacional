ANTHROPIC_API_KEY=

# Langfuse (opcional): sem as chaves, a observabilidade fica desabilitada
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Logs de correlação: LOG_PAYLOAD=off|truncated|full (conteúdo de mensagens/LLM/tools)
LOG_PAYLOAD=truncated
LOG_PAYLOAD_MAX_CHARS=2000
LOG_LEVEL=INFO
